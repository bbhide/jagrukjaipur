---
import Icon from "./Icon.astro";
import { site } from "@/lib/format";
---
<button class="scroll-top" id="scroll-top-btn" aria-label="Scroll to top" title="Back to top">↑</button>

<div class="install-banner" id="install-banner" style="display:none;" role="banner" aria-live="polite">
  <span class="text-[2rem]">📱</span>
  <p><strong>Add to Home Screen</strong>Get quick access to Jaipur events</p>
  <button class="btn btn-primary btn-sm" id="install-btn">Install</button>
  <button class="btn btn-outline btn-sm" id="install-dismiss" aria-label="Dismiss">✕</button>
</div>

<div id="ios-install-banner" style="display:none;" role="banner" aria-live="polite">
  <button id="ios-install-dismiss" aria-label="Dismiss">&times;</button>
  <div class="flex items-center gap-3">
    <img src="/favicon/apple-touch-icon.png" alt="Jagruk Jaipur" width="44" height="44" class="shrink-0 rounded-[10px]" />
    <div>
      <div class="text-[0.95rem] font-bold">Add to Home Screen</div>
      <div class="mt-0.5 text-[0.8rem] opacity-70">Get quick access to Jaipur events</div>
    </div>
  </div>
  <div class="mt-3 text-[0.82rem] leading-[1.7] opacity-85">
    Tap the <strong>Share</strong> button
    <svg class="mx-0.5 inline align-middle" width="16" height="16" fill="currentColor" viewBox="0 0 50 50"><path d="M30.3 8.5l-5.3-5.3-5.3 5.3 1.4 1.4 2.9-2.9V28h2V7l2.9 2.9 1.4-1.4zM10 15v27h30V15H10zm28 25H12V17h26v23z" /></svg>
    at the bottom of Safari, then tap <strong>"Add to Home Screen"</strong> and tap <strong>"Add"</strong>.
  </div>
  <div id="ios-share-arrow" aria-hidden="true">↓</div>
</div>

<a href={site.whatsapp} target="_blank" rel="noopener noreferrer" class="wa-bubble" id="wa-bubble" aria-label="Follow us on WhatsApp Channel">
  <Icon name="whatsapp" size={28} /><span class="wa-label">WhatsApp</span>
</a>

<div class="copy-toast" id="copy-toast" role="status">Link copied!</div>
