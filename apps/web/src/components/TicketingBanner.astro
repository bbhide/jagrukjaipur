---
/** "Now live: ticket sales" announcement used on the homepage. */
interface Props { sourcePage: string }
const { sourcePage } = Astro.props;
const highlights = [
  ["💬", "WhatsApp & Email Passes", "Instant PDF & QR code tickets sent directly to buyers."],
  ["📷", "Instant Door Scanner", "< 1 sec QR gate entry app for mobile smartphones."],
  ["📊", "Live Sales Dashboard", "Real-time revenue, booking logs, and CSV guest exports."],
  ["💰", "Transparent Settlements", "Low commission with direct bank transfers."],
];
---
<div class="submit-event-cta slide-up relative my-12 overflow-hidden rounded-3xl border border-primary/35 px-6 py-14 text-center shadow-[0_12px_40px_rgba(0,0,0,0.3)]"
     style="background: linear-gradient(135deg, rgba(124, 58, 237, 0.15) 0%, rgba(236, 72, 153, 0.08) 100%);">
  <div class="pointer-events-none absolute -top-[50px] -right-[50px] size-[200px]" style="background:radial-gradient(circle, rgba(124,58,237,0.3) 0%, transparent 70%);"></div>
  <div class="mb-5 inline-flex items-center gap-2 rounded-pill border border-[#4ade80]/40 bg-[#4ade80]/15 px-4 py-[0.35rem] text-[0.85rem] font-bold tracking-[0.03em] text-[#4ade80]">
    <span class="inline-block size-2 rounded-full bg-[#4ade80] shadow-[0_0_8px_#4ade80]" style="animation: pulse 1.5s infinite;"></span>
    NOW LIVE: TICKET SALES &amp; EVENT LISTINGS
  </div>
  <h2 class="mb-3 text-[clamp(1.6rem,4vw,2.4rem)] font-extrabold leading-[1.2] text-white">Host Events &amp; Sell Tickets in Jaipur 🎟️</h2>
  <p class="mx-auto mb-8 max-w-[650px] text-[1.05rem] leading-[1.6] text-muted">
    Organizers, venues, artists &amp; creators can now list events on Jagruk Jaipur and sell tickets effortlessly to thousands of Jaipur event lovers!
  </p>
  <div class="mx-auto mb-10 grid max-w-[900px] grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-4 text-left">
    {highlights.map(([icon, title, text]) => (
      <div class="rounded-card border border-white/8 bg-black/25 px-5 py-4">
        <div class="mb-[0.3rem] text-[1.4rem]">{icon}</div>
        <div class="mb-[0.2rem] text-[0.95rem] font-bold text-white">{title}</div>
        <div class="text-[0.8rem] text-muted">{text}</div>
      </div>
    ))}
  </div>
  <div class="flex flex-wrap justify-center gap-4">
    <a href="/organizer" class="btn btn-primary btn-lg needs-auth-ticket-btn shadow-[0_8px_24px_rgba(124,58,237,0.35)]" data-ticket-url="/organizer" data-source-page={sourcePage} data-source-button="Banner: Sell Tickets" id="home-sell-tickets-btn">🚀 Start Selling Tickets Now</a>
    <a href="/tickiting" class="btn btn-outline btn-lg border-white/25 text-white">⚡ Explore Ticketing Features →</a>
  </div>
</div>
