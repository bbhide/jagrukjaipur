---
interface Props { userName: string | null; path: string; searchValue?: string }
const { userName, path, searchValue = "" } = Astro.props;
---
<nav class="navbar" id="main-nav">
  <div class="container">
    <a href="/" class="logo" aria-label="Jagruk Jaipur Home">
      <img src="/img/logo.webp" alt="Jagruk Jaipur" class="navbar-logo-img" width="175" height="38" />
    </a>

    <form class="nav-search" action="/search" method="GET" role="search" id="nav-search-form">
      <span class="nav-search-icon" aria-hidden="true">🔍</span>
      <input type="search" name="q" id="nav-search-input" placeholder="Search events & communities…" value={searchValue} autocomplete="off" aria-label="Search events and communities" />
    </form>

    <div class="nav-actions">
      <a href="/podcast" class="btn btn-outline btn-sm nav-desktop-btn border-accent-light/40 text-accent-light" id="nav-podcast-btn">🎙️ <span>Podcast</span></a>
      <a href="/tickiting" class="btn btn-outline btn-sm nav-desktop-btn border-primary/40 text-primary-soft" id="nav-sell-tickets-btn">🎟️ <span>Sell Tickets</span></a>
      {userName ? (
        <a href="#" class="btn btn-outline btn-sm border-white/20" id="nav-profile-btn" data-open-profile>👤 <span class="nav-profile-name">{userName}</span></a>
      ) : (
        <a href="#" class="btn btn-outline btn-sm needs-auth-ticket-btn border-white/20" data-ticket-url={path} data-source-page={path} data-source-button="Header Profile Button" id="nav-profile-login-btn">
          👤 <span class="nav-profile-name">Sign In</span>
        </a>
      )}
      <a href="/search" class="btn btn-outline btn-sm needs-auth-ticket-btn" data-ticket-url="/search" data-source-page={path} data-source-button="Mobile Search Button" aria-label="Search" id="mobile-search-btn">🔍</a>
      <button class="hamburger-btn" id="mobile-menu-toggle" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobile-nav-drawer">
        <span class="hamburger-line"></span><span class="hamburger-line"></span><span class="hamburger-line"></span>
      </button>
    </div>
  </div>
</nav>
