---
/** Organiser details form, shared by registration (/organizer) and Edit Profile (/organizer/profile). */
import { STATES, type BankOnFile } from "./guard";
interface Props { values: Record<string, string>; error?: string; submitLabel: string; bankOnFile?: BankOnFile | null }
const { values: v, error, submitLabel, bankOnFile = null } = Astro.props;
---
<form method="post" class="org-form">
  {error && <div class="flash flash-error org-flash" role="alert">{error}</div>}

  <div class="glass-box org-fieldset">
    <h2 class="org-section-title">Organiser details</h2>
    <div class="org-fields">
      <div class="form-group">
        <label class="form-label" for="f-name">Brand / entity name<span class="req">*</span></label>
        <input class="form-input" id="f-name" name="name" required maxlength="120" value={v.name ?? ""} placeholder="e.g. Pink City Comedy Club" autocomplete="organization" />
      </div>
      <div class="org-fields cols-2">
        <div class="form-group">
          <label class="form-label" for="f-email">Email<span class="req">*</span></label>
          <input class="form-input" id="f-email" type="email" name="email" required maxlength="160" value={v.email ?? ""} placeholder="you@example.com" autocomplete="email" />
        </div>
        <div class="form-group">
          <label class="form-label" for="f-contact">Contact phone<span class="req">*</span></label>
          <input class="form-input" id="f-contact" type="tel" name="contact" required inputmode="numeric" maxlength="14" value={v.contact ?? ""} placeholder="10-digit mobile number" autocomplete="tel-national" />
        </div>
      </div>
      <div class="org-fields cols-2">
        <div class="form-group">
          <label class="form-label" for="f-state">State<span class="req">*</span></label>
          <select class="form-input" id="f-state" name="state" required>
            <option value="">Select state</option>
            {STATES.map((s) => <option value={s} selected={v.state === s}>{s}</option>)}
          </select>
        </div>
        <div class="form-group">
          <label class="form-label" for="f-gstin">GSTIN <span class="text-muted text-small">(optional)</span></label>
          <input class="form-input" id="f-gstin" name="gstin" maxlength="15" value={v.gstin ?? ""} placeholder="15-character GSTIN" style="text-transform:uppercase" autocomplete="off" />
        </div>
      </div>
      <div class="form-group">
        <label class="form-label" for="f-about">About you <span class="text-muted text-small">(optional)</span></label>
        <textarea class="form-input" id="f-about" name="about" maxlength="2000" placeholder="Tell attendees what you organise.">{v.about ?? ""}</textarea>
      </div>
    </div>
  </div>

  <div class="glass-box org-fieldset">
    <h2 class="org-section-title">Bank details for payouts <span class="text-muted text-small">(optional)</span></h2>
    <p class="org-note" style="margin-bottom:1.25rem">Weekly payouts are made every Monday to your registered bank account. You can add or change these details later.</p>
    {bankOnFile && (
      <div class="flash flash-success org-flash">On file: {bankOnFile.bank_name} · {bankOnFile.account_number_masked} · {bankOnFile.ifsc}. Leave the account number blank to keep it.</div>
    )}
    <div class="org-fields">
      <div class="org-fields cols-2">
        <div class="form-group">
          <label class="form-label" for="f-bank-holder">Account holder name</label>
          <input class="form-input" id="f-bank-holder" name="bank_account_holder" maxlength="120" value={v.bank_account_holder ?? bankOnFile?.account_holder ?? ""} autocomplete="off" />
        </div>
        <div class="form-group">
          <label class="form-label" for="f-bank-name">Bank name</label>
          <input class="form-input" id="f-bank-name" name="bank_name" maxlength="120" value={v.bank_name ?? bankOnFile?.bank_name ?? ""} autocomplete="off" />
        </div>
      </div>
      <div class="org-fields cols-2">
        <div class="form-group">
          <label class="form-label" for="f-bank-number">Account number</label>
          <input class="form-input" id="f-bank-number" name="bank_account_number" inputmode="numeric" maxlength="40" value={v.bank_account_number ?? ""} placeholder={bankOnFile ? bankOnFile.account_number_masked : ""} autocomplete="off" />
        </div>
        <div class="form-group">
          <label class="form-label" for="f-bank-ifsc">IFSC</label>
          <input class="form-input" id="f-bank-ifsc" name="bank_ifsc" maxlength="11" value={v.bank_ifsc ?? bankOnFile?.ifsc ?? ""} placeholder="e.g. HDFC0001234" style="text-transform:uppercase" autocomplete="off" />
        </div>
      </div>
    </div>
  </div>

  <div class="org-form-actions">
    <button class="btn btn-primary btn-lg" type="submit">{submitLabel}</button>
  </div>
</form>
