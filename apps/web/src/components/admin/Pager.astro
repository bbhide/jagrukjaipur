---
/** "Page 1 of N" with Prev / Next, keeping the other query parameters. */
interface Props { page: number; pages: number; params?: Record<string, string | undefined> }
const { page, pages, params = {} } = Astro.props;
const href = (p: number) => {
  const sp = new URLSearchParams();
  for (const [k, v] of Object.entries(params)) if (v) sp.set(k, v);
  if (p > 1) sp.set("page", String(p));
  const s = sp.toString();
  return `${Astro.url.pathname}${s ? `?${s}` : ""}`;
};
---
{pages > 1 && (
  <div style="display:flex; align-items:center; justify-content:center; gap:1rem; margin-top:1rem;">
    {page > 1 ? <a href={href(page - 1)} class="a-btn a-btn-outline a-btn-sm">← Prev</a> : <span class="a-btn a-btn-outline a-btn-sm" style="opacity:.4; pointer-events:none;">← Prev</span>}
    <span style="font-size:.85rem; color:var(--a-muted);">Page {page} of {pages}</span>
    {page < pages ? <a href={href(page + 1)} class="a-btn a-btn-outline a-btn-sm">Next →</a> : <span class="a-btn a-btn-outline a-btn-sm" style="opacity:.4; pointer-events:none;">Next →</span>}
  </div>
)}
