---
/** Full community card used on /communities (logo, tags, about + "What makes us Special?", contact hint). */
import type { Organizer } from "@/lib/types";
interface Props { org: Organizer }
const { org } = Astro.props;
const text = [org.about, org.special ? `What makes us Special?\n${org.special}` : null].filter(Boolean).join("\n");
---
<a href={`/organizer/${org.slug}`} class="community-card block rounded-2xl bg-card p-6 text-ink no-underline transition-all duration-200 hover:-translate-y-[5px] hover:border-primary/30 hover:shadow-[0_15px_30px_rgba(0,0,0,0.1)]">
  <div class="mb-4 flex items-center gap-4">
    {org.logo_path
      ? <img src={org.logo_path} alt={org.name} class="size-14 shrink-0 rounded-full border-2 border-primary/30 object-cover" loading="lazy" />
      : <div class="flex size-14 shrink-0 items-center justify-center rounded-full border-2 border-primary/30 bg-primary/15 text-2xl">🤝</div>}
    <h2 class="m-0 text-[1.2rem] leading-[1.3]">{org.name}</h2>
  </div>
  {org.categories.length > 0 && (
    <div class="mb-4 flex flex-wrap gap-[0.4rem]">
      {org.categories.map((c) => <span class="badge !text-[0.75rem]" style={`background:${c.color}22; color:${c.color}; border:1px solid ${c.color}44;`}>{c.icon} {c.name}</span>)}
    </div>
  )}
  {text && <p class="line-clamp-3 whitespace-pre-line text-[0.95rem] leading-normal text-muted">{text}</p>}
  <div class="mt-6 flex items-center justify-between pt-4">
    <span class="text-[0.9rem] font-semibold text-primary">View Profile →</span>
    {org.has_contact && (
      <span class="text-[0.85rem] text-muted">
        <svg class="mr-[2px] inline align-[-2px]" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" /></svg>
        {org.contact ?? ""}
      </span>
    )}
  </div>
</a>
