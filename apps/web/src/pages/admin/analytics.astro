---
import Admin from "@/layouts/Admin.astro";
import { adminApi } from "@/lib/admin";
import { ApiError } from "@/lib/api";
import "@/styles/admin-extra-2.css";

const sp = Astro.url.searchParams;
const range = ["today", "yesterday", "7days", "30days", "custom"].includes(sp.get("range") ?? "") ? sp.get("range")! : "7days";
let d: any, error = "";
try { d = await adminApi(Astro, "/analytics", { query: { range, start: sp.get("start"), end: sp.get("end") } }); }
catch (e) {
  if (!(e instanceof ApiError) || e.status === 401) throw e;
  error = e.message;
  d = await adminApi(Astro, "/analytics", { query: { range: "7days" } });
}
const n = (v: number) => Number(v ?? 0).toLocaleString("en-IN");
const fmtTime = (t: string) => new Date(t).toLocaleString("en-IN", { day: "numeric", month: "short", hour: "2-digit", minute: "2-digit", timeZone: "Asia/Kolkata" });
const cards: [string, string, number][] = [
  ["👤", "New Users", d.stats.new_users], ["📲", "OTPs Sent", d.stats.otps_sent], ["👁", "Event Views", d.stats.event_views], ["🎉", "Events Added", d.stats.events_added],
  ["🏁", "Events Ended", d.stats.events_ended], ["📥", "Event Submissions", d.stats.event_submissions], ["🤝", "Community Submissions", d.stats.community_submissions],
];
const chartData = JSON.stringify({ views: d.views, registrations: d.registrations, submissions: d.submissions }).replace(/</g, "\\u003c");
const mask = (num: string) => (num.length > 4 ? `${num.slice(0, 2)}••••••${num.slice(-2)}` : num);
---
<Admin title="Analytics" active="analytics">
  <div class="page-title-row"><div><h1 class="page-title">Analytics</h1><p class="page-subtitle">{d.start === d.end ? d.start : `${d.start} to ${d.end}`} (IST)</p></div></div>
  {error && <div class="a-flash a-flash-error" role="alert">{error}</div>}

  <form method="GET" class="a-filter-row" id="range-form">
    <div class="form-group"><label class="form-label" for="range">Range</label>
      <select class="form-select" name="range" id="range">
        <option value="today" selected={d.range === "today"}>Today</option><option value="yesterday" selected={d.range === "yesterday"}>Yesterday</option>
        <option value="7days" selected={d.range === "7days"}>Last 7 days</option><option value="30days" selected={d.range === "30days"}>Last 30 days</option>
        <option value="custom" selected={range === "custom"}>Custom range</option>
      </select></div>
    <div class="form-group" id="custom-fields" style={range === "custom" ? "" : "display:none;"}>
      <label class="form-label" for="start">From</label><input class="form-input" type="date" id="start" name="start" value={sp.get("start") ?? d.start} />
    </div>
    <div class="form-group" id="custom-fields-end" style={range === "custom" ? "" : "display:none;"}>
      <label class="form-label" for="end">To</label><input class="form-input" type="date" id="end" name="end" value={sp.get("end") ?? d.end} />
    </div>
    <button class="a-btn a-btn-primary" type="submit">Apply</button>
  </form>

  <div class="stats-grid">
    {cards.map(([icon, label, v]) => <div class="stat-card"><div class="stat-icon" aria-hidden="true">{icon}</div><div class="stat-info"><strong>{n(v)}</strong><span>{label}</span></div></div>)}
  </div>

  <div class="a-card"><div class="a-card-header"><h2 class="a-card-title">📈 View Trends</h2></div><div class="a-chart-box"><canvas id="chart-views" aria-label="Event views per day"></canvas></div></div>
  <div class="a-two-col" style="margin-top:1.25rem;">
    <div class="a-card"><div class="a-card-header"><h2 class="a-card-title">👤 Registration Trends</h2></div><div class="a-chart-box"><canvas id="chart-registrations" aria-label="New users per day"></canvas></div></div>
    <div class="a-card"><div class="a-card-header"><h2 class="a-card-title">📥 Submissions Trends</h2></div><div class="a-chart-box"><canvas id="chart-submissions" aria-label="Submissions per day"></canvas></div></div>
  </div>
  <script type="application/json" id="analytics-data" set:html={chartData}></script>

  <div class="a-two-col" style="margin-top:1.25rem;">
    <div class="a-card"><div class="a-card-header"><h2 class="a-card-title">🔥 Most Viewed Events</h2></div>
      {d.most_viewed_events.length === 0 ? <div class="a-empty">No views in this period.</div> : (
        <div class="a-table-wrap"><table class="a-table"><thead><tr><th>Event</th><th class="a-num">Views</th></tr></thead>
          <tbody>{d.most_viewed_events.map((e: any) => <tr><td><a href={`/events/${e.slug}`} target="_blank" rel="noopener" style="color:inherit;">{e.title}</a></td><td class="a-num">{n(e.views)}</td></tr>)}</tbody></table></div>)}
    </div>
    <div class="a-card"><div class="a-card-header"><h2 class="a-card-title">🏷 Top Categories</h2></div>
      {d.top_categories.length === 0 ? <div class="a-empty">No category engagement in this period.</div> : (
        <div class="a-table-wrap"><table class="a-table"><thead><tr><th>Category</th><th class="a-num">Engagement</th></tr></thead>
          <tbody>{d.top_categories.map((c: any) => <tr><td>{c.icon} {c.name}</td><td class="a-num">{n(c.engagement)}</td></tr>)}</tbody></table></div>)}
    </div>
    <div class="a-card"><div class="a-card-header"><h2 class="a-card-title">📄 Top OTP Pages</h2></div>
      {d.top_otp_pages.length === 0 ? <div class="a-empty">No OTPs sent in this period.</div> : (
        <div class="a-table-wrap"><table class="a-table"><thead><tr><th>Source Page</th><th class="a-num">OTPs Sent</th></tr></thead>
          <tbody>{d.top_otp_pages.map((r: any) => <tr><td>{r.source_page}</td><td class="a-num">{n(r.otps)}</td></tr>)}</tbody></table></div>)}
    </div>
    <div class="a-card"><div class="a-card-header"><h2 class="a-card-title">🖱 Top Triggers / Buttons</h2></div>
      {d.top_otp_buttons.length === 0 ? <div class="a-empty">No OTPs sent in this period.</div> : (
        <div class="a-table-wrap"><table class="a-table"><thead><tr><th>Button</th><th class="a-num">OTPs Sent</th></tr></thead>
          <tbody>{d.top_otp_buttons.map((r: any) => <tr><td>{r.source_button}</td><td class="a-num">{n(r.otps)}</td></tr>)}</tbody></table></div>)}
    </div>
  </div>

  <div class="a-card" style="margin-top:1.25rem;"><div class="a-card-header"><h2 class="a-card-title">🔐 Recent OTP Verification Logs</h2><span class="a-muted">Last 50, all time</span></div>
    {d.recent_otp_logs.length === 0 ? <div class="a-empty">No OTP requests yet.</div> : (
      <div class="a-table-wrap"><table class="a-table"><thead><tr><th>Number</th><th>Source Page</th><th>Trigger Button</th><th>Time Requested</th><th>Status</th></tr></thead>
        <tbody>{d.recent_otp_logs.map((r: any) => (
          <tr><td>{mask(r.number)}</td><td>{r.source_page ?? "—"}</td><td>{r.source_button ?? "—"}</td><td class="nowrap">{fmtTime(r.created_at)}</td>
            <td><span class:list={["a-badge", r.status === "verified" ? "a-badge-success" : r.status === "sent" ? "a-badge-info" : "a-badge-muted"]}>{r.status.toUpperCase()}</span></td></tr>))}</tbody></table></div>)}
  </div>
</Admin>

<script>
  import { Chart, LineController, LineElement, PointElement, LinearScale, CategoryScale, Tooltip, Legend, Filler } from "chart.js";
  Chart.register(LineController, LineElement, PointElement, LinearScale, CategoryScale, Tooltip, Legend, Filler);

  const sel = document.getElementById("range") as HTMLSelectElement;
  const toggle = () => ["custom-fields", "custom-fields-end"].forEach((id) => { document.getElementById(id)!.style.display = sel.value === "custom" ? "" : "none"; });
  sel.addEventListener("change", () => { toggle(); if (sel.value !== "custom") sel.form!.requestSubmit(); });

  const data = JSON.parse(document.getElementById("analytics-data")!.textContent!);
  const css = getComputedStyle(document.documentElement);
  const text = css.getPropertyValue("--a-muted").trim() || "#6b7280";
  const grid = "rgba(255,255,255,0.07)";
  const labels = (rows: { day: string }[]) => rows.map((r) => new Date(r.day + "T00:00:00").toLocaleDateString("en-IN", { day: "numeric", month: "short" }));
  const ds = (label: string, rows: any[], key: string, color: string) => ({ label, data: rows.map((r) => r[key]), borderColor: color, backgroundColor: color + "22", fill: true, tension: 0.3, pointRadius: rows.length > 31 ? 0 : 3, borderWidth: 2 });
  const make = (id: string, rows: any[], sets: any[]) => new Chart(document.getElementById(id) as HTMLCanvasElement, {
    type: "line", data: { labels: labels(rows), datasets: sets },
    options: {
      responsive: true, maintainAspectRatio: false, interaction: { mode: "index", intersect: false },
      plugins: { legend: { display: sets.length > 1, labels: { color: text } } },
      scales: { x: { ticks: { color: text, maxTicksLimit: 10 }, grid: { color: grid } }, y: { beginAtZero: true, ticks: { color: text, precision: 0 }, grid: { color: grid } } },
    },
  });
  make("chart-views", data.views, [ds("Event views", data.views, "views", "#7c3aed")]);
  make("chart-registrations", data.registrations, [ds("New users", data.registrations, "registrations", "#22c55e")]);
  make("chart-submissions", data.submissions, [ds("Events", data.submissions, "events", "#f97316"), ds("Communities", data.submissions, "communities", "#38bdf8")]);
</script>
