---
import Admin from "@/layouts/Admin.astro";
import { adminApi, handlePost } from "@/lib/admin";
import "@/styles/admin-extra-2.css";

const res = await handlePost(Astro, async (form) => {
  const action = String(form.get("action") ?? "");
  const id = Number(form.get("id"));
  if (action === "delete_episode") { await adminApi(Astro, `/podcasts/episodes/${id}`, { method: "DELETE" }); return { message: "Episode deleted." }; }
  if (action === "delete_guest") { await adminApi(Astro, `/podcasts/guests/${id}`, { method: "DELETE" }); return { message: "Guest deleted." }; }
  if (action === "delete_application") { await adminApi(Astro, `/podcasts/applications/${id}`, { method: "DELETE" }); return { message: "Application deleted." }; }
  if (action === "update_application") { await adminApi(Astro, `/podcasts/applications/${id}`, { method: "PUT", body: { status: String(form.get("status")) } }); return { message: "Application status updated." }; }
});
if (res) return res;

const tabParam = Astro.url.searchParams.get("tab");
const tab = tabParam === "guests" || tabParam === "applications" ? tabParam : "episodes";
const counts = await adminApi<{ episodes: number; guests: number; applications: number }>(Astro, "/podcasts/counts");
const data = tab === "episodes" ? (await adminApi(Astro, "/podcasts/episodes")).episodes
  : tab === "guests" ? (await adminApi(Astro, "/podcasts/guests")).guests
  : (await adminApi(Astro, "/podcasts/applications")).applications;
const fmtDate = (d?: string | null) => (d ? new Date(d.length === 10 ? `${d}T00:00:00+05:30` : d).toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric", timeZone: "Asia/Kolkata" }) : "—");
const statuses = ["pending", "contacted", "scheduled", "rejected"];
const statusBadge: Record<string, string> = { pending: "a-badge-warn", contacted: "a-badge-info", scheduled: "a-badge-success", rejected: "a-badge-danger" };
const cap = (s: string) => s[0]!.toUpperCase() + s.slice(1);
---
<Admin title="Podcasts & Guests" active="podcasts">
  <div class="page-title-row">
    <div><h1 class="page-title">Podcasts &amp; Guests</h1><p class="page-subtitle">Manage episodes, featured guests and guest applications</p></div>
    {tab === "episodes" && <a class="a-btn a-btn-primary" href="/admin/podcasts/new?type=episode">+ Add Episode</a>}
    {tab === "guests" && <a class="a-btn a-btn-primary" href="/admin/podcasts/new?type=guest">+ Add Guest</a>}
  </div>

  <div class="a-tabs" role="tablist">
    <a class:list={["a-tab", { active: tab === "episodes" }]} href="/admin/podcasts?tab=episodes">🎙️ Episodes<span class="count">{counts.episodes}</span></a>
    <a class:list={["a-tab", { active: tab === "guests" }]} href="/admin/podcasts?tab=guests">⭐ Featured Guests<span class="count">{counts.guests}</span></a>
    <a class:list={["a-tab", { active: tab === "applications" }]} href="/admin/podcasts?tab=applications">📨 Guest Applications<span class="count">{counts.applications}</span></a>
  </div>

  <div class="a-card">
    {tab === "episodes" && (data.length === 0 ? <div class="a-empty">No episodes yet.</div> : (
      <div class="a-table-wrap"><table class="a-table">
        <thead><tr><th>Ep #</th><th>Thumbnail</th><th>Title</th><th>Guest</th><th>Category</th><th>Release Date</th><th>Status</th><th>Actions</th></tr></thead>
        <tbody>{data.map((e: any) => (
          <tr>
            <td><strong>{e.episode_number}</strong></td>
            <td><img class="a-thumb" loading="lazy" src={`https://img.youtube.com/vi/${e.youtube_id}/mqdefault.jpg`} alt="" /></td>
            <td>{e.title}</td>
            <td>{e.guest_name ?? "—"}{e.guest_title && <div class="a-muted">{e.guest_title}</div>}</td>
            <td>{e.category ?? "—"}</td>
            <td class="nowrap">{fmtDate(e.release_date)}</td>
            <td><span class:list={["a-badge", e.is_active ? "a-badge-success" : "a-badge-muted"]}>{e.is_active ? "Active" : "Hidden"}</span></td>
            <td><div class="actions-cell">
              <a class="a-btn a-btn-outline a-btn-sm" href={`https://www.youtube.com/watch?v=${e.youtube_id}`} target="_blank" rel="noopener" title="Open on YouTube">▶️</a>
              <a class="a-btn a-btn-outline a-btn-sm" href={`/admin/podcasts/${e.id}?type=episode`} title="Edit">✏️</a>
              <form method="POST" class="a-inline-form" data-confirm="Delete this episode? This cannot be undone."><input type="hidden" name="action" value="delete_episode" /><input type="hidden" name="id" value={e.id} /><button class="a-btn a-btn-danger a-btn-sm" type="submit" title="Delete">🗑</button></form>
            </div></td>
          </tr>))}</tbody>
      </table></div>))}

    {tab === "guests" && (data.length === 0 ? <div class="a-empty">No featured guests yet.</div> : (
      <div class="a-table-wrap"><table class="a-table">
        <thead><tr><th>Photo</th><th>Guest Name</th><th>Title / Designation</th><th>Bio</th><th>Social Links</th><th>Actions</th></tr></thead>
        <tbody>{data.map((g: any) => (
          <tr>
            <td>{g.photo_path ? <img class="a-avatar" loading="lazy" src={g.photo_path} alt="" /> : "—"}</td>
            <td><strong>{g.name}</strong></td>
            <td>{g.designation ?? "—"}</td>
            <td style="max-width:280px;">{g.bio ? (g.bio.length > 110 ? `${g.bio.slice(0, 110)}…` : g.bio) : "—"}</td>
            <td>{Object.entries(g.socials ?? {}).length ? Object.entries(g.socials).map(([k, v]) => <a href={String(v)} target="_blank" rel="noopener" class="a-badge a-badge-info" style="margin-right:.25rem;">{k}</a>) : "—"}</td>
            <td><div class="actions-cell">
              <a class="a-btn a-btn-outline a-btn-sm" href={`/admin/podcasts/${g.id}?type=guest`} title="Edit">✏️</a>
              <form method="POST" class="a-inline-form" data-confirm="Delete this guest? This cannot be undone."><input type="hidden" name="action" value="delete_guest" /><input type="hidden" name="id" value={g.id} /><button class="a-btn a-btn-danger a-btn-sm" type="submit" title="Delete">🗑</button></form>
            </div></td>
          </tr>))}</tbody>
      </table></div>))}

    {tab === "applications" && (<>
      <div class="a-chips" id="app-filters">
        <button type="button" class="a-chip active" data-filter="all">All</button>
        {statuses.map((s) => <button type="button" class="a-chip" data-filter={s}>{cap(s)}</button>)}
      </div>
      {data.length === 0 ? <div class="a-empty">No guest applications yet.</div> : (
        <div class="a-table-wrap"><table class="a-table">
          <thead><tr><th>Applicant</th><th>Contact Info</th><th>Proposed Topic &amp; Pitch</th><th>Submitted</th><th>Status &amp; Action</th></tr></thead>
          <tbody>{data.map((a: any) => (
            <tr data-status={a.status}>
              <td><strong>{a.name}</strong>{a.designation && <div class="a-muted">{a.designation}</div>}</td>
              <td><div>{a.phone}</div><div class="a-muted">{a.email}</div></td>
              <td style="max-width:300px;"><strong>{a.topic}</strong>
                <div class="a-muted">{a.bio.length > 90 ? `${a.bio.slice(0, 90)}…` : a.bio}</div>
                <button type="button" class="a-btn a-btn-outline a-btn-sm" style="margin-top:.4rem;" data-pitch data-name={a.name} data-topic={a.topic} data-bio={a.bio}>View Full Pitch</button></td>
              <td class="nowrap">{fmtDate(a.created_at)}</td>
              <td><div class="actions-cell" style="flex-wrap:wrap;">
                <span class={`a-badge ${statusBadge[a.status]}`}>{cap(a.status)}</span>
                <form method="POST" class="a-inline-form"><input type="hidden" name="action" value="update_application" /><input type="hidden" name="id" value={a.id} />
                  <select name="status" class="form-select" aria-label="Status">{statuses.map((s) => <option value={s} selected={s === a.status}>{cap(s)}</option>)}</select>
                  <button class="a-btn a-btn-primary a-btn-sm" type="submit">Update</button></form>
                <form method="POST" class="a-inline-form" data-confirm="Delete this application? This cannot be undone."><input type="hidden" name="action" value="delete_application" /><input type="hidden" name="id" value={a.id} /><button class="a-btn a-btn-danger a-btn-sm" type="submit" title="Delete">🗑</button></form>
              </div></td>
            </tr>))}</tbody>
        </table></div>)}
    </>)}
  </div>

  <div class="a-modal" id="pitch-modal" hidden role="dialog" aria-modal="true" aria-labelledby="pitch-title">
    <div class="a-modal-box">
      <div class="a-modal-title" id="pitch-title"></div><div class="a-muted" id="pitch-topic"></div>
      <div class="a-modal-body" id="pitch-body"></div>
      <div class="a-modal-actions"><button type="button" class="a-btn a-btn-outline" id="pitch-close">Close</button></div>
    </div>
  </div>
</Admin>

<script>
  const modal = document.getElementById("pitch-modal")!;
  const close = () => { modal.hidden = true; };
  document.querySelectorAll<HTMLElement>("[data-pitch]").forEach((b) => b.addEventListener("click", () => {
    document.getElementById("pitch-title")!.textContent = `Pitch from ${b.dataset.name}`;
    document.getElementById("pitch-topic")!.textContent = `Topic: ${b.dataset.topic}`;
    document.getElementById("pitch-body")!.textContent = b.dataset.bio ?? "";
    modal.hidden = false;
  }));
  document.getElementById("pitch-close")?.addEventListener("click", close);
  modal.addEventListener("click", (e) => { if (e.target === modal) close(); });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") close(); });
  document.querySelectorAll<HTMLElement>("#app-filters .a-chip").forEach((chip) => chip.addEventListener("click", () => {
    document.querySelectorAll("#app-filters .a-chip").forEach((c) => c.classList.toggle("active", c === chip));
    const f = chip.dataset.filter;
    document.querySelectorAll<HTMLElement>("tr[data-status]").forEach((r) => { r.hidden = f !== "all" && r.dataset.status !== f; });
  }));
</script>
