---
import Base from "@/layouts/Base.astro";
import EmptyState from "@/components/EmptyState.astro";
import EventGrid from "@/components/EventGrid.astro";
import PastEventCard from "@/components/PastEventCard.astro";
import { api, ApiError } from "@/lib/api";
import { loadShell } from "@/lib/page";
import { eventUrl, site, truncate } from "@/lib/format";
import type { EventCardData, Organizer } from "@/lib/types";

const slug = Astro.params.slug ?? "";
const [{ siteData, me }, res] = await Promise.all([
  loadShell(Astro),
  api<{ organizer: Organizer; events: EventCardData[]; past_events: EventCardData[] }>(`/organizers/${encodeURIComponent(slug)}`, { request: Astro.request })
    .catch((e) => { if (e instanceof ApiError && e.status === 404) return null; throw e; }),
]);
if (!res) return Astro.rewrite("/404");
const { organizer: org, events, past_events: pastEvents } = res;

const path = Astro.url.pathname;
const sourcePage = `Organizer: ${org.name}`;
const kind = org.is_community ? "Community" : "Organiser";
const title = `${org.name} ${org.is_community ? "Community " : ""}in Jaipur — ${site.name}`;
const description = truncate((org.about ?? `Events and updates from ${org.name} on ${site.name}.`).replace(/\s+/g, " "), 160);

const handle = (v: string, base: string) => (/^https?:\/\//i.test(v) ? v : `${base}${v.replace(/^@/, "")}`);
const socials = [
  org.social_instagram && { label: "Instagram", href: handle(org.social_instagram, "https://www.instagram.com/"), cls: "bg-[linear-gradient(45deg,#f09433_0%,#e6683c_25%,#dc2743_50%,#cc2366_75%,#bc1888_100%)] text-white" },
  org.social_whatsapp && { label: "WhatsApp", href: handle(org.social_whatsapp, "https://wa.me/"), cls: "bg-[#25D366] text-white" },
  org.social_facebook && { label: "Facebook", href: handle(org.social_facebook, "https://www.facebook.com/"), cls: "bg-[#1877F2] text-white" },
  org.social_twitter && { label: "Twitter", href: handle(org.social_twitter, "https://twitter.com/"), cls: "bg-black text-white" },
  org.social_website && { label: "Website", href: handle(org.social_website, "https://"), cls: "bg-primary text-white" },
].filter(Boolean) as { label: string; href: string; cls: string }[];
// Logged-out visitors only learn which networks exist; the icons are gated behind login like the legacy site.
const gatedSocials = me ? [] : [
  ["instagram", "Instagram", "bg-[linear-gradient(45deg,#f09433_0%,#e6683c_25%,#dc2743_50%,#cc2366_75%,#bc1888_100%)] text-white"],
  ["whatsapp", "WhatsApp", "bg-[#25D366] text-white"],
  ["facebook", "Facebook", "bg-[#1877F2] text-white"],
  ["twitter", "Twitter", "bg-black text-white"],
  ["website", "Website", "bg-primary text-white"],
].filter(([k]) => org.social_available?.includes(k)).map(([, label, cls]) => ({ label, cls }));

// Legacy rendered the about text and the "special" blurb as one paragraph with nl2br().
const esc = (t: string) => t.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/\r?\n/g, "<br />");
const aboutHtml = [org.about && esc(org.about), org.special && `What makes us Special?<br />${esc(org.special)}`].filter(Boolean).join("<br /><br />");

const orgLd = {
  "@context": "https://schema.org", "@type": "Organization", name: org.name, url: `${site.url}/organizer/${org.slug}`,
  ...(org.logo_path ? { logo: org.logo_path.startsWith("http") ? org.logo_path : site.url + org.logo_path } : {}),
  description,
  ...(org.contact ? { contactPoint: { "@type": "ContactPoint", contactType: "customer support", telephone: org.contact } } : {}),
  ...(socials.length ? { sameAs: socials.map((s) => s.href) } : {}),
  events: events.map((e) => ({ "@type": "Event", name: e.title, url: site.url + eventUrl(e.slug), startDate: e.event_date, location: { "@type": "Place", name: e.venue_name ?? "Jaipur" }, organizer: { "@type": "Organization", name: org.name } })),
};
const crumbLd = {
  "@context": "https://schema.org", "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${site.url}/` },
    { "@type": "ListItem", position: 2, name: "Organisers", item: `${site.url}/communities` },
    { "@type": "ListItem", position: 3, name: org.name, item: `${site.url}/organizer/${org.slug}` },
  ],
};
const icons: Record<string, string> = {
  Instagram: "M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z",
  WhatsApp: "M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.888-.788-1.489-1.761-1.663-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.82 9.82 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.82 11.82 0 0 0-3.48-8.413Z",
  Facebook: "M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z",
  Twitter: "M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z",
};
---
<Base title={title} description={description} canonical={`/organizer/${org.slug}`} siteData={siteData} me={me} jsonLd={[orgLd, crumbLd]}>
  <div class="container">
    <nav aria-label="Breadcrumb" class="py-5 text-[0.85rem] text-muted">
      <a href="/" class="text-muted">Home</a>
      <span class="mx-2 opacity-50">/</span>
      <a href="/communities" class="text-muted">Organisers</a>
      <span class="mx-2 opacity-50">/</span>
      <span>{org.name}</span>
    </nav>

    <div class="community-header">
      {org.logo_path && (
        <div class="relative z-[1] mb-5 flex items-center justify-center">
          <img src={org.logo_path} alt={`${org.name} Logo`} class="size-[110px] rounded-full border-[3px] border-primary/40 object-cover shadow-[0_8px_30px_rgba(124,58,237,0.25)]" />
        </div>
      )}
      <h1 class="heading-lg relative z-[1]">{org.name}</h1>
      <div class="relative z-[1] mt-[0.8rem] flex justify-center"><span class="community-badge">{kind}</span></div>

      {!me && org.has_contact && (
        <button type="button" class="btn btn-outline btn-sm needs-auth-ticket-btn contact-btn" data-ticket-url={path} data-source-page={sourcePage} data-source-button="Show Contact">
          📞 Show Contact Info
        </button>
      )}
      {me && org.contact && (
        <a href={`tel:${org.contact.replace(/\s+/g, "")}`} class="btn btn-outline btn-sm contact-btn">📞 {org.contact}</a>
      )}

      {aboutHtml && <p class="community-about relative z-[1]" set:html={aboutHtml} />}

      {org.features.length > 0 && (
        <div class="relative z-[1] mx-auto mt-8 flex max-w-[700px] flex-wrap justify-center gap-[0.8rem]">
          {org.features.map((f) => <span class="community-feature-tag">{f.icon} {f.label}</span>)}
        </div>
      )}

      {gatedSocials.length > 0 && (
        <div class="relative z-[1] mt-10 flex flex-wrap justify-center gap-[1.2rem]">
          {gatedSocials.map((s) => (
            <a href="#" data-ticket-url={path} data-source-page={sourcePage} data-source-button={`Social: ${s.label}`} class:list={["social-icon-btn needs-auth-ticket-btn", s.cls]} aria-label={s.label}>
              {s.label === "Website"
                ? <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
                : <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d={icons[s.label]} /></svg>}
            </a>
          ))}
        </div>
      )}
      {me && socials.length > 0 && (
        <div class="relative z-[1] mt-10 flex flex-wrap justify-center gap-[1.2rem]">
          {socials.map((s) => (
            <a href={s.href} target="_blank" rel="noopener noreferrer" class:list={["social-icon-btn", s.cls]} aria-label={s.label}>
              {s.label === "Website"
                ? <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
                : <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d={icons[s.label]} /></svg>}
            </a>
          ))}
        </div>
      )}
    </div>

    <section class="section !pt-0" aria-labelledby="active-events-heading">
      <div class="section-header">
        <h2 class="section-title" id="active-events-heading">🗓 Upcoming &amp; Active Events</h2>
        <span class="text-muted text-small">{events.length} {events.length === 1 ? "event" : "events"}</span>
      </div>
      {events.length > 0
        ? <EventGrid events={events} sourcePage={sourcePage} />
        : <EmptyState icon="🎟" title="No Upcoming Events" text={`${org.name} doesn't have any upcoming events right now.`} />}
    </section>

    {pastEvents.length > 0 && (
      <section class="section !pt-4 opacity-85" aria-labelledby="past-events-heading">
        <div class="section-header">
          <h2 class="section-title text-muted" id="past-events-heading">🕰 Past Events</h2>
          <span class="text-muted text-small">{pastEvents.length} {pastEvents.length === 1 ? "event" : "events"}</span>
        </div>
        <div class="events-grid">
          {pastEvents.map((e) => <PastEventCard event={e} />)}
        </div>
      </section>
    )}
  </div>
</Base>

<style>
  .community-header {
    position: relative; padding: 3rem 1.5rem; border-radius: 20px; margin-bottom: 3rem; text-align: center; overflow: hidden;
    background: linear-gradient(145deg, rgba(124, 58, 237, 0.05) 0%, rgba(236, 72, 153, 0.05) 100%);
    border: 1px solid rgba(255, 255, 255, 0.05); box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  }
  .community-header::before {
    content: ""; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(circle at 50% 0%, rgba(124, 58, 237, 0.15), transparent 70%);
  }
  .community-badge {
    background: linear-gradient(90deg, #7c3aed, #ec4899); color: #fff; padding: 0.4rem 1rem; border-radius: 30px; display: inline-block;
    font-weight: 700; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px; box-shadow: 0 4px 15px rgba(124, 58, 237, 0.3);
  }
  .community-about {
    color: var(--text); font-size: 1.15rem; margin: 1.5rem auto 0; max-width: 800px; line-height: 1.7; font-weight: 400; opacity: 0.9;
  }
  .community-feature-tag {
    background: rgba(255, 255, 255, 0.03); color: var(--text); border: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.9rem; padding: 0.5rem 1rem; border-radius: 20px; transition: all 0.2s ease; backdrop-filter: blur(5px);
  }
  .community-feature-tag:hover { background: rgba(124, 58, 237, 0.1); border-color: rgba(124, 58, 237, 0.3); transform: translateY(-2px); }
  .social-icon-btn {
    transition: all 0.2s ease; border-radius: 50%; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; text-decoration: none;
  }
  .social-icon-btn:hover { transform: translateY(-3px) scale(1.05); box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3); }
  .contact-btn {
    margin-top: 1rem; position: relative; z-index: 1; display: inline-flex; align-items: center; gap: 0.5rem; cursor: pointer;
    border-color: rgba(124, 58, 237, 0.4); color: var(--text); background: rgba(255, 255, 255, 0.05); padding: 0.4rem 1rem; border-radius: 20px; font-family: inherit;
  }
</style>
