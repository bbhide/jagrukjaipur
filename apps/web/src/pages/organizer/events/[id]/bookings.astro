---
// Layout inferred — the legacy organiser portal was not observable (see docs/01-reconnaissance.md §6)
import "@/styles/pages/organizer.css";
import Base from "@/layouts/Base.astro";
import LoginRequired from "@/components/organizer/LoginRequired.astro";
import PortalNav from "@/components/organizer/PortalNav.astro";
import { loadPortal, portalFail, rupees } from "@/components/organizer/guard";
import { api } from "@/lib/api";
import { dateShort } from "@/lib/format";

const p = await loadPortal(Astro);
if (p.redirect) return p.redirect;
const { id } = Astro.params;

interface Booking { id: number; reference: string; attendee_name: string; attendee_email: string | null; attendee_phone: string | null; tier: string; quantity: number; total: number; answers: unknown; tickets: { code: string; checked_in_at: string | null }[] }
let data: { event: { id: number; title: string; event_date: string }; bookings: Booking[] } | null = null;
if (p.organizer) {
  try { data = await api(`/organizer/events/${encodeURIComponent(id ?? "")}/bookings`, { request: Astro.request }); }
  catch (e) { return portalFail(Astro, e); }
}
const answerText = (a: unknown) => Array.isArray(a)
  ? a.map((x: any) => (x && typeof x === "object" ? `${x.label ?? x.question ?? ""}${x.label ?? x.question ? ": " : ""}${x.answer ?? x.value ?? ""}` : String(x))).join(" · ")
  : "";
const totalTickets = data?.bookings.reduce((n, b) => n + b.tickets.length, 0) ?? 0;
const checkedIn = data?.bookings.reduce((n, b) => n + b.tickets.filter((t) => t.checked_in_at).length, 0) ?? 0;
---
<Base title="Guest List | Organizer Portal" canonical={`/organizer/events/${id}/bookings`} siteData={p.siteData} me={p.me} noindex>
  {!p.me || !data ? <LoginRequired /> : (
    <div class="container section">
      <div class="org-wrap">
        <PortalNav active="" />
        <a href="/organizer/dashboard" class="org-back">← Back to dashboard</a>
        <div class="organizer-header-row">
          <div>
            <h1 class="org-page-title">Guest list</h1>
            <p class="text-muted">{data.event.title} · {dateShort(data.event.event_date)}</p>
            <p class="org-note">{data.bookings.length} bookings · {totalTickets} tickets · {checkedIn} checked in</p>
          </div>
          <div class="organizer-action-btns">
            <a href={`/organizer/events/${data.event.id}/bookings.csv`} class="btn btn-primary" download>⬇ Download CSV</a>
            <a href="/organizer/scanner" class="btn btn-outline">📷 Scan Tickets</a>
          </div>
        </div>
        <div class="glass-box org-table-card">
          {data.bookings.length === 0 ? (
            <div class="org-empty">No confirmed bookings yet.</div>
          ) : (
            <div class="table-responsive">
              <table class="dashboard-table">
                <thead><tr><th>Reference</th><th>Attendee</th><th>Tier</th><th class="num">Qty</th><th class="num">Total</th><th>Answers</th><th>Checked in</th></tr></thead>
                <tbody>
                  {data.bookings.map((b) => (
                    <tr>
                      <td>{b.reference}</td>
                      <td><strong>{b.attendee_name}</strong><div class="sub">{[b.attendee_email, b.attendee_phone].filter(Boolean).join(" · ")}</div></td>
                      <td>{b.tier}</td>
                      <td class="num">{b.quantity}</td>
                      <td class="num">{rupees(b.total)}</td>
                      <td style="white-space:normal;max-width:260px">{answerText(b.answers) || "—"}</td>
                      <td>{b.tickets.filter((t) => t.checked_in_at).length}/{b.tickets.length}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </div>
      </div>
    </div>
  )}
</Base>
