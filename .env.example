# ─── Shared ───────────────────────────────────────────────────
NODE_ENV=development
PUBLIC_SITE_URL=http://localhost:4321

# ─── API (apps/api) ───────────────────────────────────────────
API_PORT=4000
DATABASE_URL=postgres://jagruk:jagruk@127.0.0.1:5433/jagruk
DATABASE_SSL=false
SESSION_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321

# First admin account, created by `npm run db:seed`
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# WhatsApp OTP. `console` prints the code to the API log (development only).
OTP_PROVIDER=console
# Development/test only: fixed code for every login. Never set in production.
OTP_DEV_CODE=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_OTP_TEMPLATE=login_otp

# Uploads: `local` writes to UPLOAD_DIR, `s3` writes to S3_BUCKET (served through CloudFront at UPLOAD_PUBLIC_BASE)
UPLOAD_DRIVER=local
UPLOAD_DIR=../web/public/uploads
UPLOAD_PUBLIC_BASE=/uploads
S3_BUCKET=
AWS_REGION=ap-south-1

# Optional integrations (can also be set from Admin → Settings)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
GEMINI_API_KEY=
SMTP_URL=
MAIL_FROM="Jagruk Jaipur <no-reply@jagrukjaipur.com>"

# ─── Web (apps/web) ───────────────────────────────────────────
# Where the Astro server reaches the API from inside the network
API_INTERNAL_URL=http://127.0.0.1:4000
PUBLIC_CLARITY_ID=
PUBLIC_WHATSAPP_CHANNEL=https://whatsapp.com/channel/0029Vb7sCKPJENy09PC2ln1X
PUBLIC_INSTAGRAM_URL=https://www.instagram.com/jagrukjaipur
PUBLIC_YOUTUBE_URL=https://www.youtube.com/@jagrukjaipur
