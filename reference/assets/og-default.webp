<script>
document.addEventListener('DOMContentLoaded', () => {
  document.body.addEventListener('click', async (e) => {
    const btn = e.target.closest('#load-more-btn');
    if (!btn) return;
    
    e.preventDefault();
    
    const originalText = btn.innerText;
    btn.innerText = 'Loading...';
    btn.style.pointerEvents = 'none';
    btn.style.opacity = '0.7';
    
    try {
      const res = await fetch(btn.href);
      if (!res.ok) throw new Error('Network response was not ok');
      const html = await res.text();
      
      const parser = new DOMParser();
      const doc = parser.parseFromString(html, 'text/html');
      
      const newEvents = doc.querySelectorAll('#events-grid .event-card');
      const eventsGrid = document.getElementById('events-grid');
      
      if (eventsGrid && newEvents.length > 0) {
        newEvents.forEach(card => {
          if (typeof revealObserver !== 'undefined') {
            revealObserver.observe(card);
          }
          eventsGrid.appendChild(card);
        });
      }
      
      const newPagination = doc.querySelector('.pagination');
      const currentPagination = btn.closest('.pagination');
      
      if (newPagination && currentPagination) {
        currentPagination.innerHTML = newPagination.innerHTML;
      } else if (currentPagination) {
        currentPagination.remove();
        const endMsg = document.getElementById('end-of-events');
        if (endMsg) {
          endMsg.style.display = 'block';
          if (typeof revealObserver !== 'undefined') revealObserver.observe(endMsg);
        }
      }
      
    } catch (err) {
      console.error('Failed to load more events', err);
      btn.innerText = originalText;
      btn.style.pointerEvents = 'auto';
      btn.style.opacity = '1';
    }
  });
});
</script>



