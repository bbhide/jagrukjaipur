<!-- iOS: manual guide shown in Safari only (iOS doesn't support auto-prompt) -->
<div id="ios-install-banner" style="display:none;" role="banner" aria-live="polite">
  <button id="ios-install-dismiss" aria-label="Dismiss">&times;</button>
  <div style="display:flex; align-items:center; gap:0.75rem;">
