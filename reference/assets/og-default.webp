      style="border-radius:10px; flex-shrink:0;">
    <div>
      <div style="font-weight:700; font-size:0.95rem;">Add to Home Screen</div>
      <div style="font-size:0.8rem; opacity:0.7; margin-top:2px;">Get quick access to Jaipur events</div>
    </div>
  </div>
  <div style="margin-top:0.75rem; font-size:0.82rem; line-height:1.7; opacity:0.85;">
    Tap the <strong>Share</strong> button
    <svg style="display:inline; vertical-align:middle; margin:0 2px;" width="16" height="16" fill="currentColor"
      viewBox="0 0 50 50">
      <path
        d="M30.3 8.5l-5.3-5.3-5.3 5.3 1.4 1.4 2.9-2.9V28h2V7l2.9 2.9 1.4-1.4zM10 15v27h30V15H10zm28 25H12V17h26v23z" />
    </svg>
    at the bottom of Safari, then tap <strong>"Add to Home Screen"</strong> and tap <strong>"Add"</strong>.
  </div>
  <!-- Arrow pointing to bottom of screen where Safari share button is -->
  <div id="ios-share-arrow" aria-hidden="true">↓</div>
</div>

<style>
  #ios-install-banner {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: rgba(20, 10, 35, 0.97);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-top: 1px solid rgba(124, 58, 237, 0.3);
    color: #fff;
    padding: 1rem 1.25rem 1.5rem;
    z-index: 9998;
    font-family: 'Outfit', sans-serif;
    box-shadow: 0 -8px 32px rgba(0, 0, 0, 0.4);
    animation: ios-banner-in 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes ios-banner-in {
    from {
      transform: translateY(100%);
      opacity: 0;
    }

    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  #ios-install-dismiss {
    position: absolute;
    top: 0.6rem;
    right: 0.75rem;
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.5);
    font-size: 1.4rem;
    cursor: pointer;
    line-height: 1;
  }

  #ios-share-arrow {
    text-align: center;
    font-size: 1.5rem;
    margin-top: 0.5rem;
    animation: ios-arrow-bounce 1s ease-in-out infinite;
    color: var(--primary-light, #a78bfa);
  }

  @keyframes ios-arrow-bounce {

    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(6px);
    }
  }
</style>

<script>
  (function () {
    // Only run once per session
    if (sessionStorage.getItem('pwa_banner_dismissed')) return;
    // Don't show if already running as installed PWA
    if (window.navigator.standalone || window.matchMedia('(display-mode: standalone)').matches) return;

    var isIOS = /iphone|ipad|ipod/i.test(navigator.userAgent);
    var isSafari = /^((?!chrome|android).)*safari/i.test(navigator.userAgent);

    if (isIOS && isSafari) {
      // Show iOS banner after 3 seconds
      setTimeout(function () {
        var banner = document.getElementById('ios-install-banner');
        if (banner) banner.style.display = 'block';
      }, 3000);
      var dismiss = document.getElementById('ios-install-dismiss');
      if (dismiss) {
        dismiss.addEventListener('click', function () {
          document.getElementById('ios-install-banner').style.display = 'none';
          sessionStorage.setItem('pwa_banner_dismissed', '1');
        });
      }
    }
    // Android banner is handled by main.js via beforeinstallprompt
  })();
</script>

